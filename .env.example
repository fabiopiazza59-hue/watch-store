# Optional. Without a key the AI designer runs in offline (keyword) mode.
ANTHROPIC_API_KEY=
# Optional overrides.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# Optional spend cap: Claude conversations per UTC day, after which the offline designer answers.
DESIGN_DAILY_LIMIT=
# Where orders are stored as JSON files.
ORDERS_DIR=./data/orders
# New orders accepted per UTC day.
ORDERS_DAILY_LIMIT=200
# Optional. Makes the order API workshop-only (Authorization: Bearer <token> or the atelier_workshop cookie).
WORKSHOP_TOKEN=
# Optional. Signs customers' order confirmation links; defaults to WORKSHOP_TOKEN.
ORDER_LINK_SECRET=
# Optional. The site's public address, e.g. https://atelier.example: API writes from other origins are
# refused, and an https:// address adds HSTS. Read at build time.
PUBLIC_ORIGIN=
# Optional. Set when a reverse proxy appends the client address to X-Forwarded-For.
TRUST_PROXY=
